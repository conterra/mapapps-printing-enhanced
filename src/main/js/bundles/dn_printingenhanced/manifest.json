{
    "name": "dn_printingenhanced",
    "version": "2.3.4-SNAPSHOT",
    "title": "${bundleName}",
    "description": "${bundleDescription}",
    "vendor": "con terra GmbH",
    "keywords": [
        "print",
        "AGS"
    ],
    "icon": {},
    "i18n": [
        "bundle"
    ],
    "productName": "devnet-mapapps-printing-enhanced",
    "dependencies": {
        "@arcgis/core": "^4.33.0",
        "apprt-vue": "^4.20.0",
        "apprt-vuetify": "^4.20.0",
        "apprt-binding": "^4.20.0",
        "apprt-core": "^4.20.0",
        "apprt-fetch": "^4.20.0",
        "printing": "^4.20.0",
        "map-widget": "^4.20.0",
        "coordinatetransformer": "^4.20.0",
        "bluebird": "2.5.0-SNAPSHOT",
        "jszip": "2.5.0-SNAPSHOT"
    },
    "cssThemesExtension": [
        {
            "name": "*",
            "files": [
                "./css/styles.css"
            ]
        }
    ],
    "layout-widgets": [
        {
            "widgetRole": "printingEnhancedWidget",
            "window": {
                "title": "${windowTitle}",
                "dockTool": "printingEnhancedToggleTool",
                "closable": true,
                "maximizable": false,
                "minimizeOnClose": true,
                "windowClass": "noPadding",
                "marginBox": {
                    "w": 340,
                    "h": 425
                }
            }
        },
        {
            "widgetRole": "printingEnhancedWidget",
            "sublayout": [
                "desktop"
            ],
            "window": {
                "resizable": true,
                "marginBox": {
                    "w": 340,
                    "h": 425,
                    "t": 125,
                    "l": 25
                },
                "minSize": {
                    "w": 340,
                    "h": 350
                }
            }
        },
        {
            "widgetRole": "printingEnhancedWidget",
            "sublayout": [
                "tablet_landscape",
                "tablet_portrait"
            ],
            "window": {
                "resizable": false,
                "draggable": false,
                "marginBox": {
                    "w": 340,
                    "h": 425,
                    "t": 125,
                    "l": 25
                }
            }
        },
        {
            "widgetRole": "printingEnhancedWidget",
            "sublayout": [
                "mobile_landscape",
                "mobile_portrait"
            ],
            "window": {
                "dockable": true,
                "dockingBar": "${id}-dockingBarBottomLeft",
                "resizable": false,
                "marginBox": {
                    "w": "100%",
                    "h": "50%",
                    "b": 0
                }
            }
        }
    ],
    "components": [
        {
            "name": "PrintingPreviewController",
            "immediate": true,
            "provides": [
                "ct.framework.api.EventHandler",
                "dn_printingenhanced.PrintingPreviewController"
            ],
            "properties": {
                "Event-Topics": [
                    {
                        "topic": "dn_printingenhanced/PRINTSETTINGS",
                        "method": "setPrintSettings"
                    }
                ]
            },
            "references": [
                {
                    "name": "_printingWidget",
                    "providing": "dijit.Widget",
                    "filter": "(widgetRole=printing)"
                },
                {
                    "name": "_printingEnhancedProperties",
                    "providing": "dn_printingenhanced.PrintingEnhancedProperties"
                },
                {
                    "name": "_printingInfosAnalyzer",
                    "providing": "dn_printingenhanced.PrintingInfosAnalyzer"
                },
                {
                    "name": "_printingPreviewDrawer",
                    "providing": "dn_printingenhanced.PrintingPreviewDrawer",
                    "cardinality": "0..1"
                },
                {
                    "name": "printingToggleTool",
                    "providing": "ct.tools.Tool",
                    "filter": "(id=printingToggleTool)",
                    "cardinality": "0..1"
                },
                {
                    "name": "printingEnhancedToggleTool",
                    "providing": "ct.tools.Tool",
                    "filter": "(id=printingEnhancedToggleTool)",
                    "cardinality": "0..1"
                },
                {
                    "name": "mapWidgetModel",
                    "providing": "map-widget.MapWidgetModel",
                    "cardinality": "0..1"
                },
                {
                    "name": "userService",
                    "providing": "ct.framework.api.UserAdmin",
                    "cardinality": "0..1"
                },
                {
                    "name": "_logger",
                    "providing": "ct.framework.api.LogService",
                    "cardinality": "0..1"
                }
            ]
        },
        {
            "name": "Config",
            "impl": "ct/Stateful",
            "provides": [
                "dn_printingenhanced.PrintingEnhancedProperties"
            ],
            "propertiesConstructor": true,
            "properties": {
                "templateOptions": {
                    "attributionEnabled": true,
                    "legendEnabled": true,
                    "scaleEnabled": true,
                    "dpi": 150
                },
                "visibleUiElements": {
                    "layoutTab": true,
                    "mapOnlyTab": false,
                    "title": true,
                    "fileName": true,
                    "author": true,
                    "format": true,
                    "widthAndHeight": true,
                    "dpi": true,
                    "printPreviewCheckbox": false,
                    "scaleEnabled": false,
                    "scale": true,
                    "copyright": false,
                    "attributionEnabled": false,
                    "mapSeriesTab": true,
                    "doNotPrintEmptyTiles": true,
                    "legendEnabled": false
                },
                "deriveLayoutFromPageSize": false,
                "enablePrintPreview": true,
                "enablePrintPreviewMovement": true,
                "layoutTemplatesInfoTaskName": "Get%20Layout%20Templates%20Info%20Task",
                "defaultPageUnit": "CENTIMETER",
                "legend": {
                    "defaultLegendEnabled": true,
                    "legendNameIfNoneIsGiven": "${ui.legendNameIfNoneIsGiven}"
                },
                "printSizes": [
                    {
                        "value": "a4",
                        "text": "A4",
                        "isDefault": true
                    },
                    {
                        "value": "a3",
                        "text": "A3",
                        "isDefault": false
                    }
                ],
                "printOrientations": [
                    {
                        "value": "portrait",
                        "text": "${ui.portraitLabel}",
                        "isDefault": true
                    },
                    {
                        "value": "landscape",
                        "text": "${ui.landscapeLabel}",
                        "isDefault": false
                    }
                ],
                "layoutNames": {
                    "a4_portrait": "A4 Portrait Overview",
                    "a4_portrait_singlepage": "A4 Portrait Singlepage",
                    "a4_landscape": "A4 Landscape Overview",
                    "a4_landscape_singlepage": "A4 Landscape Singlepage",
                    "a3_portrait": "A3 Portrait Overview",
                    "a3_portrait_singlepage": "A3 Portrait Singlepage",
                    "a3_landscape": "A3 Landscape Overview",
                    "a3_landscape_singlepage": "A3 Landscape Singlepage",
                    "legend": "A4_hoch_legende",
                    "mapOnly": "MAP_ONLY"
                },
                "dpiValues": [
                    {
                        "value": 96,
                        "text": "${ui.low}"
                    },
                    {
                        "value": 150,
                        "text": "${ui.medium}"
                    },
                    {
                        "value": 300,
                        "text": "${ui.high}"
                    }
                ],
                "scaleValues": [],
                "allowedFormats": "all",
                "allowedLayouts": "all",
                "printingPreviewSymbol": {
                    "type": "simple-fill",
                    "color": [
                        0,
                        0,
                        0,
                        0
                    ],
                    "style": "solid",
                    "outline": {
                        "color": [
                            0,
                            0,
                            0,
                            1
                        ],
                        "width": "2px"
                    }
                },
                "printingOverviewSymbol": {
                    "type": "esriSFS",
                    "style": "esriSFSSolid",
                    "color": [
                        255,
                        0,
                        0,
                        64
                    ],
                    "outline": {
                        "type": "esriSLS",
                        "style": "esriSLSSolid",
                        "color": [
                            255,
                            0,
                            0,
                            255
                        ],
                        "width": 2
                    }
                },
                "printingOverviewLabelSymbol": {
                    "type": "esriTS",
                    "color": [
                        0,
                        0,
                        0,
                        255
                    ],
                    "font": {
                        "family": "Arial",
                        "size": 18,
                        "style": "normal",
                        "weight": "bold"
                    }
                },
                "printingPreviewOmittedTilesSymbol": {
                    "type": "simple-fill",
                    "color": [
                        102,
                        102,
                        102,
                        0.15
                    ],
                    "style": "solid",
                    "outline": {
                        "color": [
                            102,
                            102,
                            102,
                            0.7
                        ],
                        "width": "2px"
                    }
                },
                "printingOutsidePreviewSymbol": {
                    "type": "simple-fill",
                    "color": [
                        0,
                        0,
                        0,
                        0.5
                    ],
                    "style": "solid",
                    "outline": {
                        "color": [
                            0,
                            0,
                            0,
                            1
                        ],
                        "width": "2px"
                    }
                },
                "useUsernameAsAuthor": true,
                "usernameAttributes": [
                    "givenname",
                    "sn"
                ],
                "customTextElements": [],
                "graphicsLayerId": "printing-enhanced-graphics",
                "graphicsLayerTitle": "${ui.graphicsLayerTitle}",
                "mapSeriesTileOverlap": 0.05
            }
        },
